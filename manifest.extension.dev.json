{
    "name": "Copyyt",
    "description": "Securely sync copied text across your trusted devices with end-to-end encryption.",
    "version": "2.0.1",
    "manifest_version": 3,
    "minimum_chrome_version": "137",
    "background": {
        "service_worker": "assets/service-worker.js",
        "type": "module"
    },
    "action": {
        "default_popup": "index.html",
        "default_icon": "copyyt.png"
    },
    "icons": {
        "16": "icon-16x16.png",
        "48": "icon-48x48.png",
        "128": "icon-128x128.png"
    },
    "key": "",
    "oauth2": {
        "client_id": "367598261435-81eadc06f97is9l3aogrncpa1183ke9f.apps.googleusercontent.com",
        "scopes": [
            "openid",
            "email",
            "profile"
        ]
    },
    "permissions": [
        "identity",
        "clipboardRead",
        "clipboardWrite",
        "offscreen",
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "https://api.copyyt.psami.com/*",
        "http://localhost:8000/*",
        "http://localhost:8001/*",
        "http://127.0.0.1:8000/*",
        "http://127.0.0.1:8001/*",
        "http://192.168.0.121:8000/*",
        "http://192.168.0.121:8001/*"
    ]
}
